# StudyHub V2 - Environment Configuration Example
# Copy this file to .env for local testing (never commit real credentials)

# Flask Core Configuration
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_SECRET_KEY=generate-a-strong-random-secret-key-min-32-chars

# Platform Owner Bootstrap Token (used once during first-time /setup)
OWNER_BOOTSTRAP_TOKEN=your-secure-bootstrap-token-here

# TiDB Cloud Starter Configuration (MySQL Protocol)
# Example host: gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_HOST=gateway01.region.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=studyhub_v2
TIDB_CA_PATH=

# Cloudflare R2 (S3-compatible) Object Storage Configuration
# Account ID from Cloudflare Dashboard -> R2 Overview
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_BUCKET_NAME=studyhub-v2-production
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Storage Safety Limits (bytes)
# 9 GiB safety limit for Cloudflare R2 free tier (9 * 1024 * 1024 * 1024)
MAX_TENANT_STORAGE_BYTES=9663676416
MAX_FILE_SIZE_BYTES=104857600

# Rate Limiting
RATELIMIT_STORAGE_URL=memory://
